# The tools the shared checks download, pinned by exact version and by the sha256 of each release archive.
# .github/workflows/checks.yml reads this file at its own commit, and a local hook may read it to run the same versions.
# Dependabot does not see these downloads: bump a version and its checksums together, taking each checksum from the
# release page and confirming it against a download. tools/check-versions.sh checks the format.

# https://github.com/rhysd/actionlint/releases
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256_LINUX_X64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ACTIONLINT_SHA256_DARWIN_ARM64=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f

# https://github.com/zizmorcore/zizmor/releases
ZIZMOR_VERSION=1.31.1
ZIZMOR_SHA256_LINUX_X64=d185f726bdaf92df78273217dfdd24ebcd6b0ef48cf3ce776ff5762b6e138c99
ZIZMOR_SHA256_DARWIN_ARM64=ad5aa633cd56215b11e6c51d51f90c7e6b22904a75047d1215abbd422f61d698

# Socket Firewall Free (sfw), installed by SocketDev/action, which otherwise downloads the latest release.
# https://github.com/SocketDev/sfw-free/releases
SFW_VERSION=1.15.4
